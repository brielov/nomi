expression: "render(&text, nomi_syntax::parse_expr)"
input_file: crates/syntax/test_data/parser/expressions/minus_before_comma.elm
---
ExprFragment@0..9
  ListExpr@0..8
    LBracket@0..1 "["
    Whitespace@1..2 " "
    OperatorChain@2..3
      Missing@2..2
      Op@2..3
        Minus@2..3 "-"
      Missing@3..3
    Comma@3..4 ","
    Whitespace@4..5 " "
    NameExpr@5..6
      LowerIdent@5..6 "a"
    Whitespace@6..7 " "
    RBracket@7..8 "]"
  Newline@8..9 "\n"
error 2..3: ExpectedExpression
error 3..4: ExpectedExpression
