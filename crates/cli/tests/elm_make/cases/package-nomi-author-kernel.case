=== note
a package by nomi's author imports kernel code, which upstream allows only elm and elm-explorations
=== args
make
src/Foo.elm
--report=json
--output=/dev/null
=== file elm.json
{"type": "package", "name": "nomi/foo", "summary": "kernel code by the author nomi bundles", "license": "BSD-3-Clause", "version": "1.0.0", "exposed-modules": ["Foo"], "elm-version": "0.19.0 <= v < 0.20.0", "dependencies": {"elm/core": "1.0.0 <= v < 2.0.0"}, "test-dependencies": {}}
=== file src/Foo.elm
module Foo exposing (x)
import Elm.Kernel.Foo
x : Int
x = Elm.Kernel.Foo.x
=== file src/Elm/Kernel/Foo.js
var _Foo_x = 1;
