{
    "type": "application",
    "source-directories": ["src"],
    "elm-version": "0.19.1",
    "dependencies": {
        "direct": {"acme/shared": "1.0.0", "elm/core": "1.0.5", "elm/json": "1.1.4", "nomi/core": "1.0.0"},
        "indirect": {"elm/bytes": "1.0.8"}
    },
    "test-dependencies": {
        "direct": {"elm-explorations/test": "2.2.1"},
        "indirect": {"elm/html": "1.0.1", "elm/random": "1.0.0", "elm/time": "1.0.0", "elm/virtual-dom": "1.0.5"}
    }
}
=== file apps/api/nomi.toml
[[entry]]
main = "src/Main.elm"
=== file apps/api/src/Main.elm
module Main exposing (main)

import Nomi
import Shared
import Task


main : Nomi.Program
main =
    Nomi.program <|
        \_ -> Task.succeed () |> Task.map (\_ -> Debug.log Shared.greeting ())
=== file apps/api/tests/ApiTest.elm
module ApiTest exposing (shouts)

import Expect
import Shared
import Test exposing (Test, test)


shouts : Test
shouts =
    test "shouts" <|
        \() -> Expect.equal "HELLO" Shared.greeting
