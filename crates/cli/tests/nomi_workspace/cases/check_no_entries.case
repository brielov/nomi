module Main exposing (main)

import Page


main : Program () Int ()
main =
    Platform.worker
        { init = \() -> ( Page.size, Cmd.none )
        , update = \() n -> ( n, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
