=== file src/Page.elm
module Page exposing (title, view)

import Html exposing (Html)


title : String
title =
    "Home"


view : Html msg
view =
    Html.div [] [ Html.text title ]
=== file src/Main.elm
module Main exposing (main)

import Html exposing (Html)
import Page


main : Program () (Html ()) ()
main =
    Platform.worker
        { init = \_ -> ( Page.view, Cmd.none )
        , update = \_ model -> ( model, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
