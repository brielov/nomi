=== note
an entry's FFI module that isn't there, named as nomi.toml names it
=== args
build
=== file elm.json
{"type": "application", "source-directories": ["src"], "elm-version": "0.19.1", "dependencies": {"direct": {"elm/core": "1.0.5", "elm/json": "1.1.4"}, "indirect": {}}, "test-dependencies": {"direct": {}, "indirect": {}}}
=== file nomi.toml
[[entry]]
main = "src/Main.elm"
output = "dist/main.mjs"
platform = "node"
ffi = "src/missing.mjs"
=== file src/Main.elm
module Main exposing (main)


main : Program () () ()
main =
    Platform.worker
        { init = \_ -> ( (), Cmd.none )
        , update = \_ model -> ( model, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
