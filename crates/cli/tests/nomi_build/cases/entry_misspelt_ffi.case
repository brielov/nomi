=== note
a call to a function an entry's FFI module doesn't export, the module named as nomi.toml names it
=== args
build
=== file elm.json
{"type": "application", "source-directories": ["src"], "elm-version": "0.19.1", "dependencies": {"direct": {"elm/core": "1.0.5", "elm/json": "1.1.4", "nomi/core": "1.0.0"}, "indirect": {"elm/bytes": "1.0.8"}}, "test-dependencies": {"direct": {}, "indirect": {}}}
=== file nomi.toml
[[entry]]
main = "src/Main.elm"
output = "dist/main.mjs"
ffi = "src/ffi.mjs"
=== file src/ffi.mjs
export async function add(n) { return n + 1; }
=== file src/Main.elm
module Main exposing (main)

import Json.Decode
import Json.Encode
import Nomi
import Nomi.Ffi
import Task


main : Nomi.Program
main =
    Nomi.program <|
        \_ ->
            Nomi.Ffi.task "ad" (Json.Encode.int 1) Json.Decode.int
                |> Task.mapError (\_ -> "ffi")
                |> Task.map (\_ -> ())
