=== file src/Flip.elm
module Flip exposing (flip)

{-| Reverse the arguments of a function with only two arguments.

@docs flip

-}


{-| Flip, for functions of one type.
-}
flip : (a -> a -> b) -> a -> a -> b
flip function argB argA =
    function argA argB
