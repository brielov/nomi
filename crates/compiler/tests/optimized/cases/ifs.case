=== note
if and else-if chains
=== args
make
src/Main.elm
=== file src/Main.elm
module Main exposing (..)


sign n =
    if n < 0 then
        -1

    else if n == 0 then
        0

    else
        1


nested a b =
    if a then
        if b then
            1

        else
            2

    else
        3
