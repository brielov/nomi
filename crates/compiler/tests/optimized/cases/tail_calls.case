=== note
tail calls at the top level and in lets
=== args
make
src/Main.elm
=== file src/Main.elm
module Main exposing (..)


sum acc list =
    case list of
        [] ->
            acc

        x :: rest ->
            sum (acc + x) rest


countdown n =
    if n <= 0 then
        0

    else
        countdown (n - 1)


local n =
    let
        go acc i =
            if i == 0 then
                acc

            else
                go (acc * i) (i - 1)
    in
    go 1 n
