=== file src/Main.elm
module Main exposing (..)

import Html exposing (Html, text)


type Shape
    = Circle Float
    | Square Float


area : Shape -> Float
area shape =
    case shape of
        Circle r ->
            pi * r * r

        Square s ->
            s * s


main : Html msg
main =
    text (String.fromFloat (area (Circle 2)))
