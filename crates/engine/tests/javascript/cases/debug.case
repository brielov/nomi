=== file src/Main.elm
module Main exposing (main)


main : Program () String ()
main =
    Platform.worker
        { init = \_ -> ( Debug.toString (Debug.log "start" [ 1, 2, 3 ]), Cmd.none )
        , update = \_ model -> ( model, Cmd.none )
        , subscriptions = \_ -> Sub.none
        }
