=== note
names whose order differs between releases: 0.19.3 sorts by length first
=== args
make
--docs=docs.json
=== file elm.json
{
    "type": "package",
    "name": "author/project",
    "summary": "A package to document",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Zz",
        "Abc",
        "B"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {}
}
=== file src/Zz.elm
module Zz exposing (zz, abc, b, Bb, Aaa)

{-| Zz.

@docs zz, abc, b, Bb, Aaa

-}


{-| -}
type Bb
    = Bb


{-| -}
type alias Aaa =
    Int


{-| -}
zz : Int
zz =
    1


{-| -}
abc : Int
abc =
    1


{-| -}
b : Int
b =
    1
