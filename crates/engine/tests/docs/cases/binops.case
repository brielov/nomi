=== file src/A.elm
module A exposing (append, (+++), (<<<))

{-| A.

@docs append, (+++), (<<<)

-}


infix right 5 (+++) = append
infix left  0 (<<<) = compose


{-| Append. -}
append : String -> String -> String
append a b =
    a ++ b


{-| Compose. -}
compose : (b -> c) -> (a -> b) -> a -> c
compose f g x =
    f (g x)
