=== file src/A.elm
module A exposing ((+++), (<<<))

{-| A.

@docs (+++), (<<<)

-}


infix right 5 (+++) = append
infix left  0 (<<<) = compose


append a b =
    a ++ b


compose : (b -> c) -> (a -> b) -> a -> c
compose f g x =
    f (g x)
